{
  "manifest_version": 3,
  "name": "Nexus Sidebar: All your needs in one place",
  "version": "17.0.0",
  "description": "Browser productivity workspace with Nexus Hub, focus, tabs, notes, tools and contextual actions.",
  "author": "Numberstring Productions",
  "permissions": ["storage","history","tabs","scripting","favicon","declarativeNetRequestWithHostAccess","alarms","contentSettings","notifications","contextMenus","bookmarks","downloads","downloads.open","sessions","topSites","tabGroups","clipboardRead","clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker":"background.js"},
  "action": {"default_title":"Show Nexus Sidebar","default_icon":{"16":"icons/icon.png","32":"icons/icon.png"}},
  "icons": {"16":"icons/icon.png","32":"icons/icon.png","48":"icons/icon.png","128":"icons/icon.png"},
  "web_accessible_resources": [{"resources":["_favicon/*"],"matches":["<all_urls>"]}],
  "content_scripts": [
    {"matches":["<all_urls>"],"css":["styles/base.css","styles/themes.css","styles/refine.css","styles/controls-autohide.css","styles/nexus-suite.css"],"js":["src/core.js","src/sites.js","src/apps.js","src/games.js","src/settings.js","src/update-ui.js","src/controls-autohide.js","src/nexus-suite.js","src/nexus-suite-enhancements.js"],"run_at":"document_start","all_frames":false,"match_about_blank":true},
    {"matches":["http://*/*","https://*/*"],"js":["frame-session-bridge.js"],"run_at":"document_start","all_frames":true}
  ],
  "chrome_url_overrides": {"newtab":"newtab.html"}
}
